<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="jakarta.servlet.http.HttpSession" %>
<% HttpSession s=request.getSession(false); if(s==null||s.getAttribute("username")==null){response.sendRedirect("login.jsp");return;} String username=(String)s.getAttribute("username"); %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chat</title>
<style>body{margin:0;font-family:Arial,sans-serif;background:#eef2f7}.top{background:#1677ff;color:#fff;padding:14px 20px;display:flex;justify-content:space-between}.top a{color:#fff;text-decoration:none}.wrap{max-width:760px;margin:30px auto;background:#fff;padding:20px;border-radius:14px;box-shadow:0 8px 30px #0001}.messages{height:430px;overflow:auto;border:1px solid #e0e5eb;border-radius:10px;padding:12px}.msg{padding:10px;margin:8px 0;background:#f3f5f7;border-radius:10px}.mine{background:#dff6df}.meta{font-size:12px;color:#667085;margin-bottom:4px}.time{font-size:11px;color:#8a94a3}.form{display:flex;gap:8px;margin-top:12px}.form input{padding:12px;border:1px solid #ccd3dc;border-radius:8px}.receiver{width:150px}.text{flex:1}.form button{padding:12px 18px;border:0;border-radius:8px;background:#1677ff;color:#fff;cursor:pointer}</style></head><body>
<div class="top"><strong>Simple Chat</strong><span>Logged in: <b><%= username %></b> &nbsp; <a href="logout">Logout</a></span></div>
<div class="wrap"><h2>Messages</h2><div id="messages" class="messages"></div><div class="form"><input id="receiver" class="receiver" placeholder="Receiver" value="user2"><input id="message" class="text" placeholder="Type a message" maxlength="2000"><button onclick="sendMessage()">Send</button></div><p id="status"></p></div>
<script>
const currentUser=<%= org.apache.jasper.runtime.JspRuntimeLibrary.toString(username) == null ? "null" : "\"" + username.replace("\\","\\\\").replace("\"","\\\"") + "\"" %>;
function esc(v){return String(v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));}
async function loadMessages(){const r=document.getElementById('receiver').value.trim();if(!r)return;try{const res=await fetch('messages?receiver='+encodeURIComponent(r));if(!res.ok)throw new Error();const data=await res.json();const box=document.getElementById('messages');box.innerHTML=data.length?'':'<div style="color:#888;text-align:center;padding:20px">No messages yet</div>';data.forEach(m=>{const d=document.createElement('div');d.className='msg '+(m.sender===currentUser?'mine':'');d.innerHTML='<div class="meta"><b>'+esc(m.sender)+'</b> → <b>'+esc(m.receiver)+'</b></div><div>'+esc(m.message)+'</div><div class="time">'+esc(m.time)+'</div>';box.appendChild(d)});box.scrollTop=box.scrollHeight;}catch(e){document.getElementById('status').textContent='Could not load messages.';}}
async function sendMessage(){const r=document.getElementById('receiver').value.trim(),m=document.getElementById('message').value.trim();if(!r||!m){alert('Enter receiver and message');return;}const body=new URLSearchParams({receiver:r,message:m});try{const res=await fetch('messages',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body});if(!res.ok)throw new Error();document.getElementById('message').value='';await loadMessages();}catch(e){document.getElementById('status').textContent='Could not send message.';}}
document.getElementById('message').addEventListener('keydown',e=>{if(e.key==='Enter')sendMessage()});loadMessages();setInterval(loadMessages,2000);
</script></body></html>
